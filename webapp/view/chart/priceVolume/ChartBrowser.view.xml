<!DOCTYPE xml>
<mvc:View
	controllerName="trading-cockpit-frontend.controller.chart.priceVolume.ChartBrowser"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core">
	
	<Page title="{i18n>chartBrowser.header}">
		<headerContent>
			<Button icon="sap-icon://hint" tooltip="{i18n>chartDistributionDays.typeTooltip}" press=".onChartInformationPressed"/>
		</headerContent>
		
		<content>
			<Carousel pages="{path: 'instruments>/instrument/'}">
				<pages>
					<Text text="{instruments>id}" />
					<!-- Getting error when querying chart url from within my application. 403 - Forbidden -->
					<!-- <Image src="{ path: 'instruments>', formatter: '.chartUrlFormatter'}"/> -->				
				</pages>
			</Carousel>
			
			<core:HTML content="&lt;iframe src='tradingview-chart-widget.html' style='width:100%; height:100%; border:0;' &gt;&lt;/iframe&gt;" />	
		</content>
	</Page>
</mvc:View>